                  "pm.test('Response contains ai_message', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.ai_message).to.be.a('string');",
                  "    pm.expect(jsonData.ai_message.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('is_complete is false', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.is_complete).to.be.false;",
                  "});"
